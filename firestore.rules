rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isCampaignMaster(campaignId) {
      return isAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.masterId == request.auth.uid
      );
    }

    function isCampaignMember(campaignId) {
      return isAuthenticated() && (
        isCampaignMaster(campaignId) ||
        exists(/databases/$(database)/documents/campaign_members/$(campaignId + '_' + request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'player');
      allow update: if isUser(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Campaigns Collection
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && (resource.data.isPublic == true || isCampaignMember(campaignId));
      allow create: if isAuthenticated() && (request.resource.data.masterId == request.auth.uid || isAdmin());
      allow update, delete: if isCampaignMaster(campaignId);
    }

    // Campaign Members
    match /campaign_members/{memberDocId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCampaignMaster(resource.data.campaignId)
      );
    }

    // Characters Collection
    match /characters/{characterId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCampaignMaster(resource.data.campaignId) ||
        isCampaignMember(resource.data.campaignId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCampaignMaster(resource.data.campaignId)
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCampaignMaster(resource.data.campaignId)
      );
    }

    // Abilities & Grimoire
    match /abilities/{abilityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Ability Usages & Logs
    match /ability_usages/{usageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Innate Capabilities
    match /innate_capabilities/{capId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Combat Encounters & Turns
    match /combat_encounters/{encounterId} {
      allow read: if isAuthenticated() && isCampaignMember(resource.data.campaignId);
      allow create, update, delete: if isAuthenticated() && isCampaignMaster(request.resource.data.campaignId);
    }

    match /combat_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Maps & Tokens
    match /maps/{mapId} {
      allow read: if isAuthenticated() && isCampaignMember(resource.data.campaignId);
      allow create, update, delete: if isAuthenticated() && isCampaignMaster(request.resource.data.campaignId);
    }

    match /map_tokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Inventories & Items
    match /inventories/{inventoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // System Elements & Catalog
    match /system_elements/{elementId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Classes & Relations
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /class_relations/{relationId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // System Rules (Pending & Validated Rules)
    match /system_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAuthenticated();
    }

    // Synergies
    match /synergies/{synergyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default catch-all
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
